# Compilación de SwiftPM: se regenera con `swift build` / `bash build-app.sh`.
.build/

# Empaquetado: `build-app.sh` y `make-dmg.sh` lo rehacen desde la fuente, y son
# binarios. Versionarlos hacía que cada compilación ensuciara el árbol y que .git
# creciera ~800 KB por versión sin aportar nada que la fuente no tenga.
dist/

# Prototipo publicado: lo regenera `Scripts/publicar.py` desde
# `Sources/brisa_app/Resources/index.html`. Versionarlo era guardar dos veces lo
# mismo —raíz y `Docs/prototype/` eran idénticas— y envejecer con cada cambio.
prototipo-brisa.html

# Finder
.DS_Store

# Estado de las herramientas que trabajan en este proyecto (identificador de
# sesión, enlaces a skills globales). No son fuente de Brisa y cambian solas.
.freebuff/
.agents/
